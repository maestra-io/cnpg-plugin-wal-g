+package s3_test
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	"github.com/aws/aws-sdk-go-v2/service/s3/types"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	walgs3 "github.com/wal-g/wal-g/pkg/storages/s3"
+	"github.com/wal-g/wal-g/pkg/storages/storage"
+)
+
+// mockS3ClientDeleteErrors answers DeleteObjects with HTTP 200 and the given
+// per-key errors, the way R2 answers a delete refused by a bucket lock.
+type mockS3ClientDeleteErrors struct {
+	mockS3ClientVersioning
+	keyErrors map[string]string // key -> error code
+	calls     int
+}
+
+func (m *mockS3ClientDeleteErrors) DeleteObjects(_ context.Context, in *s3.DeleteObjectsInput,
+	_ ...func(*s3.Options)) (*s3.DeleteObjectsOutput, error) {
+	m.calls++
+	out := &s3.DeleteObjectsOutput{}
+	for _, obj := range in.Delete.Objects {
+		if code, ok := m.keyErrors[aws.ToString(obj.Key)]; ok {
+			out.Errors = append(out.Errors, types.Error{Key: obj.Key, Code: aws.String(code), Message: aws.String(code)})
+			continue
+		}
+		out.Deleted = append(out.Deleted, types.DeletedObject{Key: obj.Key})
+	}
+	return out, nil
+}
+
+func deleteWith(t *testing.T, keyErrors map[string]string, names ...string) (error, int) {
+	client := &mockS3ClientDeleteErrors{keyErrors: keyErrors}
+	folder := walgs3.NewFolder(client, nil, "prefix/", &walgs3.Config{Bucket: "b", DeleteBatchSize: 2})
+	objects := make([]storage.Object, 0, len(names))
+	for _, n := range names {
+		objects = append(objects, storage.NewLocalObject(n, time.Time{}, 0))
+	}
+	return folder.DeleteObjects(t.Context(), objects), client.calls
+}
+
+func TestDeleteObjects_AllDeleted(t *testing.T) {
+	err, _ := deleteWith(t, nil, "a", "b", "c")
+	assert.NoError(t, err)
+}
+
+func TestDeleteObjects_LockedKeysAreRetainedNotDeleted(t *testing.T) {
+	err, calls := deleteWith(t, map[string]string{
+		"prefix/a": storage.ObjectLockedErrorCode,
+		"prefix/c": storage.ObjectLockedErrorCode,
+	}, "a", "b", "c")
+	var retained storage.ObjectsRetainedError
+	require.True(t, errors.As(err, &retained), "got %v", err)
+	assert.Equal(t, []string{"prefix/a", "prefix/c"}, retained.Keys)
+	assert.Equal(t, 2, calls, "a retained key must not stop the next batch")
+}
+
+func TestDeleteObjects_OtherKeyErrorFails(t *testing.T) {
+	err, _ := deleteWith(t, map[string]string{
+		"prefix/a": storage.ObjectLockedErrorCode,
+		"prefix/b": "AccessDenied",
+	}, "a", "b")
+	require.Error(t, err)
+	var retained storage.ObjectsRetainedError
+	assert.False(t, errors.As(err, &retained))
+	assert.Contains(t, err.Error(), "prefix/b (AccessDenied")
+}
