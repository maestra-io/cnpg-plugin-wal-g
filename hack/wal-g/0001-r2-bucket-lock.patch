+// handleLockedWALUpload runs when a bucket lock refused the upload: the segment is
+// already in storage and younger than the lock age (a concurrent push won the
+// race, or a retry after a lost response). Equal content is archived already;
+// different content cannot be fixed by retrying until the lock age passes.
+func handleLockedWALUpload(ctx context.Context, uploader *WalUploader, walFilePath string, uploadErr error) error {
+	overwriteAttempt, err := checkWALOverwrite(ctx, uploader, walFilePath)
+	switch {
+	case overwriteAttempt && err == nil:
+		return nil
+	case overwriteAttempt:
+		return errors.Wrapf(err, "upload of '%s' refused by bucket lock", walFilePath)
+	case err != nil:
+		return errors.Wrapf(err, "upload of '%s' refused by bucket lock (%v), and the stored segment could not be compared",
+			walFilePath, uploadErr)
+	default:
+		return errors.Wrapf(uploadErr, "upload of '%s' refused by bucket lock, but no stored segment was found", walFilePath)
+	}
+}
