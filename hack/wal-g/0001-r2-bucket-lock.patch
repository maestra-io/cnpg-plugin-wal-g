+package internal
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/wal-g/wal-g/pkg/storages/storage"
+)
+
+// retainingFolder answers every delete the way an R2 bucket lock does.
+type retainingFolder struct {
+	storage.Folder
+}
+
+func (f retainingFolder) DeleteObjects(_ context.Context, objects []storage.Object) error {
+	keys := make([]string, 0, len(objects))
+	for _, o := range objects {
+		keys = append(keys, o.GetName())
+	}
+	return storage.ObjectsRetainedError{Keys: keys}
+}
+
+func (f retainingFolder) GetSubFolder(path string) storage.Folder {
+	return retainingFolder{f.Folder.GetSubFolder(path)}
+}
+
+func TestDeleteObjectsWhere_RetainedByLockIsNotAFailure(t *testing.T) {
+	folder := retainingFolder{CreateMockStorageFolder(t.Context())}
+	err := DeleteObjectsWhere(t.Context(), folder, true,
+		func(storage.Object) bool { return true }, func(string) bool { return true })
+	assert.NoError(t, err)
+	// nothing was deleted
+	objects, _, err := folder.GetSubFolder("basebackups_005/").ListFolder(t.Context())
+	assert.NoError(t, err)
+	assert.NotEmpty(t, objects)
+}
