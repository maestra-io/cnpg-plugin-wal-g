+// DeleteObjects deletes objects in batches. S3 answers DeleteObjects with HTTP 200
+// and a per-key error list, so a refused key is read from the response: a key a
+// bucket lock still retains is reported as storage.ObjectsRetainedError (the rest
+// of the batch is deleted), any other per-key error fails the call.
 func (folder *Folder) DeleteObjects(ctx context.Context, objects []storage.Object) error {
 	parts := partitionObjects(objects, folder.config.DeleteBatchSize)
+	var retained []string
 
 	for _, part := range parts {
 		tracelog.DebugLogger.Printf("len of part  %d", len(part))
@@ -497,13 +502,29 @@ func (folder *Folder) DeleteObjects(ctx context.Context, objects []storage.Objec
 			}
 			input.Delete.Objects = append(input.Delete.Objects, objectIdentifier)
 		}
-		_, err := folder.s3API.DeleteObjects(ctx, input, withContentMD5)
+		out, err := folder.s3API.DeleteObjects(ctx, input, withContentMD5)
 		if err != nil {
 			for _, obj := range part {
 				tracelog.DebugLogger.Printf("object %s version %s", obj.GetName(), obj.GetVersionID())
 			}
 			return errors.Wrapf(err, "failed to delete s3 object: '%s'", part)
 		}
+		var failed []string
+		for _, keyErr := range out.Errors {
+			key := aws.ToString(keyErr.Key)
+			if aws.ToString(keyErr.Code) == storage.ObjectLockedErrorCode {
+				tracelog.WarningLogger.Printf("object %s retained by bucket lock, not deleted", key)
+				retained = append(retained, key)
+				continue
+			}
+			failed = append(failed, fmt.Sprintf("%s (%s: %s)", key, aws.ToString(keyErr.Code), aws.ToString(keyErr.Message)))
+		}
+		if len(failed) > 0 {
+			return fmt.Errorf("failed to delete %d of %d s3 object(s): %s", len(failed), len(part), strings.Join(failed, ", "))
+		}
+	}
