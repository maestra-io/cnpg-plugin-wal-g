+package postgres_test
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/aws/smithy-go"
+	"github.com/spf13/viper"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/wal-g/wal-g/internal"
+	"github.com/wal-g/wal-g/internal/asm"
+	"github.com/wal-g/wal-g/internal/compression"
+	conf "github.com/wal-g/wal-g/internal/config"
+	"github.com/wal-g/wal-g/internal/databases/postgres"
+	"github.com/wal-g/wal-g/pkg/storages/memory"
+	"github.com/wal-g/wal-g/pkg/storages/storage"
+	"github.com/wal-g/wal-g/testtools"
+)
+
+// lockedFolder refuses every upload the way an R2 bucket lock refuses an
+// overwrite of an object younger than the lock age.
+type lockedFolder struct {
+	*memory.Folder
+}
+
+func (f lockedFolder) PutObject(_ context.Context, name string, _ io.Reader) error {
+	return fmt.Errorf("failed to upload '%s': %w", name, &smithy.GenericAPIError{
+		Code:    storage.ObjectLockedErrorCode,
+		Message: "Object is locked by bucket policy",
+	})
+}
+
+// pushUnderLock archives one segment with content local while storage holds
+// stored (nil: nothing stored) and every upload is refused by the lock.
+func pushUnderLock(t *testing.T, local, stored []byte) error {
+	viper.Set(conf.PreventWalOverwriteSetting, false) // the lock path must not depend on the pre-check
+	t.Cleanup(func() { viper.Set(conf.PreventWalOverwriteSetting, false) })
+
+	dir, _ := setupArchiveStatus(t, "")
+	t.Cleanup(func() { testtools.Cleanup(t, dir) })
+	walDir := filepath.Join(dir, "pg_wal")
+	name := testFilename("1")
+	addTestDataFile(t, walDir, "1")
+	require.NoError(t, os.WriteFile(filepath.Join(walDir, name), local, 0600))
+	viper.Set(conf.PgDataSetting, dir)
+
+	folder := memory.NewFolder("in_memory/", memory.NewKVS())
+	compressor := compression.Compressors["lz4"]
+	if stored != nil {
+		storedPath := filepath.Join(t.TempDir(), name)
+		require.NoError(t, os.WriteFile(storedPath, stored, 0600))
+		f, err := os.Open(storedPath)
+		require.NoError(t, err)
+		defer f.Close()
+		plain := postgres.NewWalUploader(internal.NewRegularUploader(compressor, folder), nil)
+		require.NoError(t, plain.UploadWalFile(t.Context(), f))
+	}
+
+	uploader := postgres.NewWalUploader(internal.NewRegularUploader(compressor, lockedFolder{folder}), nil)
+	uploader.ArchiveStatusManager = asm.NewFakeASM()
+	return postgres.HandleWALPush(t.Context(), uploader, filepath.Join(walDir, name))
+}
+
+func TestWalPushUnderLock_EqualContentIsArchived(t *testing.T) {
+	assert.NoError(t, pushUnderLock(t, []byte("segment"), []byte("segment")))
+}
+
+func TestWalPushUnderLock_DifferentContentFailsFast(t *testing.T) {
+	err := pushUnderLock(t, []byte("segment"), []byte("another segment"))
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "refused by bucket lock")
+	assert.Contains(t, err.Error(), "contents differ")
+}
+
+func TestWalPushUnderLock_NothingStoredFails(t *testing.T) {
+	err := pushUnderLock(t, []byte("segment"), nil)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "refused by bucket lock, but no stored segment was found")
+}
