index 333551ab..823d47e0 100644
--- a/pkg/storages/s3/retryer_test.go
+++ b/pkg/storages/s3/retryer_test.go
@@ -422,3 +422,18 @@ func s3ResponseError(status int, err error) *smithyhttp.ResponseError {
 		Err:      err,
 	}
 }
+
+func TestWalgRetryablesBucketLockIsFinal(t *testing.T) {
+	locked := s3ResponseError(409, &smithy.GenericAPIError{
+		Code:    "ObjectLockedByBucketPolicy",
+		Message: "Object is locked by bucket policy",
+	})
+	assert.Equal(t, aws.FalseTernary, walgRetryables{}.IsErrorRetryable(locked))
+	// the composed retryer agrees, so the SDK returns the refusal at once
+	assert.False(t, newRetryerFunc(&Config{MaxRetries: 15})().IsErrorRetryable(locked))
+
+	// other 409s keep the old behaviour
+	conflict := s3ResponseError(409, &smithy.GenericAPIError{Code: "OperationAborted"})
+	assert.Equal(t, aws.TrueTernary, walgRetryables{}.IsErrorRetryable(conflict))
+	assert.True(t, newRetryerFunc(&Config{MaxRetries: 15})().IsErrorRetryable(conflict))
+}
diff --git a/pkg/storages/storage/errors.go b/pkg/storages/storage/errors.go
index 886179dd..82ceed39 100644
--- a/pkg/storages/storage/errors.go
+++ b/pkg/storages/storage/errors.go
@@ -26,6 +26,29 @@ func IsTransientIOError(err error) bool {
 	return errors.As(err, &networkError) && networkError.Timeout()
 }
 
+// ObjectLockedErrorCode is the error code Cloudflare R2 returns (HTTP 409 for a
+// single-object request, a per-key error of DeleteObjects) when a bucket lock rule
+// still covers the object: it can be neither deleted nor overwritten until it is
+// older than the rule's age.
+const ObjectLockedErrorCode = "ObjectLockedByBucketPolicy"
+
+// IsObjectLockedError reports whether err carries the bucket lock refusal code.
+func IsObjectLockedError(err error) bool {
+	var apiErr interface{ ErrorCode() string }
+	return errors.As(err, &apiErr) && apiErr.ErrorCode() == ObjectLockedErrorCode
+}
+
+// ObjectsRetainedError is returned by DeleteObjects when the storage refused to
+// delete some objects because a bucket lock still retains them, and nothing else
+// failed. The other objects of the request were deleted.
+type ObjectsRetainedError struct {
+	Keys []string
+}
+
+func (err ObjectsRetainedError) Error() string {
+	return fmt.Sprintf("%d object(s) retained by bucket lock, not deleted", len(err.Keys))
+}
+
 type ObjectNotFoundError struct {
 	error
 }
